          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_messages_fts_AFTER_INSERT AFTER INSERT ON `messages` BEGIN INSERT INTO `messages_fts`(`docid`, `body`, `audio_transcript`) VALUES (NEW.`rowid`, NEW.`body`, NEW.`audio_transcript`); END"
        ]
